<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageTags>functional;functional paradigm;helpers;astar;astardevelopment</PackageTags>
    <Title>AStar Dev Functional Paradigm</Title>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Description>A collection of useful functional programming extensions.</Description>
    <PackageProjectUrl>https://github.com/astar-development/astar-dev-mono/tree/main/packages/core</PackageProjectUrl>
    <DocumentationFile>$(AssemblyName).xml</DocumentationFile>
    <PackageReleaseNotes>
        v0.1.0 update astardev.functionalparadigm csproj to include nuget details
    v0.1.0 Initial release - largely a port of the existing functional programming utilities: AStar.Dev.Functional.Extensions.
    </PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CA1724;CA1062;CA1034;CA1708</NoWarn>
  </PropertyGroup>

</Project>
