<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>This package contains extension methods designed to add OpenTelemetry logging, tracing, and metrics, exported to Azure Monitor (Application Insights), to the project. The logging is opinionated but the configuration can be overridden.</Description>
        <DocumentationFile>$(AssemblyName).xml</DocumentationFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IsPackable>true</IsPackable>
        <PackageId>AStarDev.LoggingExtensions</PackageId>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReleaseNotes>
        v3.1.0 feat(logging): export error.type on failed operations (#1374)
        v3.0.0 fix(logging)!: hash paths and account ids, drop URLs and users from log attributes (#1376)
        v2.0.0 feat(logging)!: complete the OTel resource (service.version, instance id, deployment environment) (#1370)
        v1.0.0 fix(logging)!: log exception type names only, remove exception-taking templates (#1371)
        v0.1.0 fix(logging)!: log exception type names only, remove exception-taking templates (#1371)
        v0.1.0 fix(logging): log page views as PageView and 500 errors with EventId 500 (#1377)
        v0.2.0 feat: key-point logging and a local log file
        v0.1.2 chore: enforce code style in build repo-wide
        v0.1.1 chore: solution cleanup - namespaces, XML doc formatting, test folder alignment
        </PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageTags>Logging Application Insights OpenTelemetry LoggerMessage Templates</PackageTags>
        <PackageProjectUrl>https://github.com/astar-development/astar-dev-mono/tree/main/packages/core/logging</PackageProjectUrl>
        <Title>AStarDev.LoggingExtensions</Title>
        <NoWarn>$(NoWarn);CA1724;CA1062</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../../utilities/AStarDev.Utilities/AStarDev.Utilities.csproj" />
      <ProjectReference Include="../AStarDev.LoggingOTel/AStarDev.LoggingOTel.csproj" />
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>

</Project>
