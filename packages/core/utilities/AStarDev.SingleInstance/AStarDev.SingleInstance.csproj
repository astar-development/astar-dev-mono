<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AStarDev.SingleInstance
    ═══════════════════════
    Keeps one running instance per user for the AStar desktop apps: a lock file
    in the app's data folder, and a Unix domain socket next to it that lets a
    second launch ask the running instance to show its window.

    TFM, nullable, analysers, IsPackable and SourceLink are inherited from
    packages/Directory.Build.props and the repo root Directory.Build.props.
  -->

  <PropertyGroup>
    <PackageReleaseNotes>
        v0.1.0 feat(cloudsync): single instance via new AStarDev.SingleInstance package (#1461)
    </PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageTags>single-instance;desktop;astar;astardevelopment</PackageTags>
    <Title>AStar Dev Single Instance</Title>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Description>One running instance per user for AStar Development desktop apps, with a hand-off that brings the running window forward.</Description>
    <PackageProjectUrl>https://github.com/astar-development/astar-dev-mono/tree/main/packages/core/utilities</PackageProjectUrl>
    <DocumentationFile>$(AssemblyName).xml</DocumentationFile>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      CA1034: InstanceClaim is a discriminated union; its cases are nested sealed records by repo convention.
      CA1812: SingleInstanceGuard is internal and only created by the DI container (AddSingleInstance).
      CA2000: the held lock stream and the listening socket are handed to PrimaryInstance, which the caller
      disposes through InstanceClaim.Primary; SocketOwner disposes a socket that fails to bind.
    -->
    <NoWarn>$(NoWarn);CA1034;CA1812;CA2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Testably.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../functional/AStarDev.FunctionalParadigm/AStarDev.FunctionalParadigm.csproj" />
    <ProjectReference Include="../../logging/AStarDev.LoggingExtensions/AStarDev.LoggingExtensions.csproj" />
  </ItemGroup>

</Project>
