<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:classifications="clr-namespace:AStarDev.OneDriveSyncClient.Classifications"
        x:Class="AStarDev.OneDriveSyncClient.Classifications.CategoryEditDialog"
        x:DataType="classifications:CategoryNodeViewModel"
        x:Name="Root"
        Title="{Binding #Root.Text.EditDialogTitleText}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="{Binding #Root.Text.EditDialogNameText}"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
        <TextBox Text="{Binding EditedName}"
                 FontSize="{StaticResource FontSizeMd}"/>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox Content="{Binding #Root.Text.FamousText}" IsChecked="{Binding IsFamous}"/>
            <CheckBox Content="{Binding #Root.Text.InternetText}" IsChecked="{Binding IsInternet}"/>
        </StackPanel>

        <ToggleSwitch Content="{Binding #Root.Text.IncludeInSearchText}"
                      IsChecked="{Binding IncludeInSearch}"/>

        <TextBlock Text="{Binding #Root.Text.ParentText}"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
        <TextBox Text="{Binding ParentFilterText}"
                 PlaceholderText="{Binding #Root.Text.FilterPlaceholderText}"
                 FontSize="{StaticResource FontSizeSm}"
                 CornerRadius="{StaticResource RadiusMd}"/>
        <ComboBox ItemsSource="{Binding FilteredParentOptionNames}"
                  SelectedItem="{Binding SelectedParentOptionName}"
                  HorizontalAlignment="Stretch"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding #Root.Text.CancelText}"
                    Padding="12,6"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Command="{Binding CancelCommand}"/>
            <Button Content="{Binding #Root.Text.SaveText}"
                    Padding="12,6"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{DynamicResource TextAccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>

</Window>
