<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test doubles and test data shared by more than one CloudSync test project.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA2007;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AStarDev.CloudSync/AStarDev.CloudSync.csproj" />
    <ProjectReference Include="../AStarDev.CloudSync.ViewModels/AStarDev.CloudSync.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
  </ItemGroup>

</Project>
