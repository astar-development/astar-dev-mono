<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmOverview="using:AStarDev.CloudSync.ViewModels.Overview"
             x:Class="AStarDev.CloudSync.Overview.StatTile"
             x:DataType="vmOverview:StatTileViewModel"
             Foreground="{DynamicResource CloudSyncTextPrimaryBrush}"
             HorizontalAlignment="Left"
             VerticalAlignment="Top">
    <StackPanel Spacing="2">
        <TextBlock Classes="stat-value"
                   Classes.warn="{Binding IsWarn}"
                   Classes.accent="{Binding IsAccent}"
                   Text="{Binding Value}" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Classes="muted" Text="{Binding Label}" />
    </StackPanel>
</UserControl>
