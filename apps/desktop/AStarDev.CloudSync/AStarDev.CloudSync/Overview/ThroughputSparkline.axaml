<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:AStarDev.CloudSync.Overview"
             xmlns:vmOverview="using:AStarDev.CloudSync.ViewModels.Overview"
             x:Class="AStarDev.CloudSync.Overview.ThroughputSparkline"
             x:DataType="vmOverview:ThroughputViewModel"
             Foreground="{DynamicResource CloudSyncTextPrimaryBrush}"
             VerticalAlignment="Top">
    <StackPanel Spacing="8">
        <TextBlock Classes="muted" Text="{Binding Title}" />
        <overview:Sparkline Height="44"
                            Values="{Binding Values}"
                            Stroke="{DynamicResource CloudSyncAccentBrush}"
                            AutomationProperties.Name="{Binding CurrentText}" />
        <TextBlock Text="{Binding CurrentText}" FontSize="12" />
    </StackPanel>
</UserControl>
