<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:displaySettings="using:AStarDev.CloudSync.DisplaySettings"
             xmlns:vm="using:AStarDev.CloudSync.ViewModels"
             xmlns:vmDisplaySettings="using:AStarDev.CloudSync.ViewModels.DisplaySettings"
             x:Class="AStarDev.CloudSync.DisplaySettings.DisplaySettingsButton"
             x:DataType="vmDisplaySettings:DisplaySettingsViewModel"
             DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DisplaySettings}">
    <Button Name="SettingsButton"
            Width="44"
            Height="44"
            Padding="0"
            CornerRadius="8"
            Background="Transparent"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            ToolTip.Tip="{Binding Title}"
            AutomationProperties.Name="{Binding Title}">
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" Opening="OnSettingsOpening">
                <displaySettings:DisplaySettingsView />
            </Flyout>
        </Button.Flyout>
        <Path Width="24"
              Height="24"
              StrokeThickness="2"
              Stroke="{DynamicResource CloudSyncTextMutedBrush}"
              Data="M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9" />
    </Button>
</UserControl>
