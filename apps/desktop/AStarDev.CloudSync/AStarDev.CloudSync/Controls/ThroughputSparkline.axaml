<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AStarDev.CloudSync.ViewModels"
             xmlns:controls="using:AStarDev.CloudSync.Controls"
             x:Class="AStarDev.CloudSync.Controls.ThroughputSparkline"
             x:DataType="vm:ThroughputViewModel"
             Foreground="{DynamicResource CloudSyncTextPrimaryBrush}"
             VerticalAlignment="Top">
    <StackPanel Spacing="8">
        <TextBlock Classes="muted" Text="{Binding Title}" />
        <controls:Sparkline Height="44"
                            Values="{Binding Values}"
                            Stroke="{DynamicResource CloudSyncAccentBrush}"
                            AutomationProperties.Name="{Binding CurrentText}" />
        <TextBlock Text="{Binding CurrentText}" FontSize="12" />
    </StackPanel>
</UserControl>
