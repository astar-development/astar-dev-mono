<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AStarDev.CloudSync.ViewModels"
             x:Class="AStarDev.CloudSync.Controls.StorageBar"
             x:DataType="vm:StorageViewModel"
             VerticalAlignment="Top">
    <StackPanel Spacing="6">
        <ProgressBar Classes="storage-bar" Value="{Binding Fraction}" AutomationProperties.Name="{Binding Text}" />
        <TextBlock Classes="muted" Text="{Binding Text}" />
    </StackPanel>
</UserControl>
