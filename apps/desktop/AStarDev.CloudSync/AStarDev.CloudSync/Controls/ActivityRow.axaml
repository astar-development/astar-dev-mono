<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AStarDev.CloudSync.ViewModels"
             xmlns:controls="using:AStarDev.CloudSync.Controls"
             x:Class="AStarDev.CloudSync.Controls.ActivityRow"
             x:DataType="vm:ActivityItemViewModel"
             Foreground="{DynamicResource CloudSyncTextPrimaryBrush}"
             VerticalAlignment="Top">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <controls:ProviderBadge Grid.Column="0" DataContext="{Binding Provider}" />
        <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding WhenText}" VerticalAlignment="Center" />
    </Grid>
</UserControl>
