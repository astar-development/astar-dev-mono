<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AStarDev.CloudSync.ViewModels"
             x:Class="AStarDev.CloudSync.Controls.StatTile"
             x:DataType="vm:StatTileViewModel"
             Foreground="{DynamicResource CloudSyncTextPrimaryBrush}"
             HorizontalAlignment="Left"
             VerticalAlignment="Top">
    <StackPanel Spacing="2">
        <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Classes="muted" Text="{Binding Label}" />
    </StackPanel>
</UserControl>
