<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accounts="using:AStarDev.CloudSync.Accounts"
             xmlns:vmActivity="using:AStarDev.CloudSync.ViewModels.Activity"
             x:Class="AStarDev.CloudSync.Activity.ActivityRow"
             x:DataType="vmActivity:ActivityItemViewModel"
             Foreground="{DynamicResource CloudSyncTextPrimaryBrush}"
             VerticalAlignment="Top">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <accounts:ProviderBadge Grid.Column="0" DataContext="{Binding Provider}" />
        <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding WhenText}" VerticalAlignment="Center" />
    </Grid>
</UserControl>
