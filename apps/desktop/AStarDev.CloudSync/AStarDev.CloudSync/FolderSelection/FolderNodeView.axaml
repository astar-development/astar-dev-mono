<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AStarDev.CloudSync.FolderSelection"
             xmlns:vmFolders="using:AStarDev.CloudSync.ViewModels.FolderSelection"
             x:Class="AStarDev.CloudSync.FolderSelection.FolderNodeView"
             x:DataType="vmFolders:FolderNodeViewModel"
             HorizontalAlignment="Stretch">
    <StackPanel Spacing="4">
        <Grid ColumnDefinitions="28,Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Classes="secondary"
                    Padding="0"
                    Width="28"
                    FontFamily="avares://AStarDev.CloudSync/Assets/Fonts#Noto Sans Symbols 2"
                    Content="{Binding ExpanderGlyph}"
                    Command="{Binding ToggleExpandedCommand}"
                    IsVisible="{Binding MayHaveChildren}"
                    AutomationProperties.Name="{Binding Name}" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    Padding="6,0"
                    FontFamily="avares://AStarDev.CloudSync/Assets/Fonts#Noto Sans Symbols 2"
                    Content="{Binding CheckGlyph}"
                    Command="{Binding ToggleCommand}"
                    IsEnabled="{Binding CanToggle}"
                    AutomationProperties.Name="{Binding AccessibleName}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource CloudSyncTextPrimaryBrush}" />
                <TextBlock Classes="muted"
                           Text="{Binding OriginText}"
                           FontSize="11" />
                <TextBlock Text="{Binding CaseClashText}"
                           IsVisible="{Binding HasCaseClash}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource CloudSyncWarnBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="3"
                       Text="{Binding DirectionText}"
                       IsVisible="{Binding IsPairRoot}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource CloudSyncTextMutedBrush}" />
            <Button Grid.Column="4"
                    Classes="secondary"
                    Content="{Binding ChangeDirectionText}"
                    Command="{Binding ChangeDirectionCommand}"
                    IsVisible="{Binding IsPairRoot}" />
        </Grid>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasLoadError}">
            <TextBlock Text="{Binding LoadErrorText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource CloudSyncWarnBrush}" />
            <Button Classes="secondary" Content="{Binding RetryText}" Command="{Binding ExpandCommand}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Children}"
                      IsVisible="{Binding IsExpanded}"
                      Margin="28,0,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmFolders:FolderNodeViewModel">
                    <local:FolderNodeView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
