<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Thin Avalonia host: XAML views, minimal code-behind and the DI
    composition root. Behaviour belongs in AStarDev.CloudSync.ViewModels.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Product>AStar Dev CloudSync</Product>
    <ApplicationIcon>Assets\astar.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Testably.Abstractions" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/Localization/**" />
    <EmbeddedResource Include="Assets/Localization/*.json" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Debug.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AStarDev.CloudSync.DisplaySettings/AStarDev.CloudSync.DisplaySettings.csproj" />
    <ProjectReference Include="../AStarDev.CloudSync.Overview/AStarDev.CloudSync.Overview.csproj" />
    <ProjectReference Include="../AStarDev.CloudSync.Accounts.OneDrive/AStarDev.CloudSync.Accounts.OneDrive.csproj" />
    <ProjectReference Include="../AStarDev.CloudSync.Accounts.Sqlite/AStarDev.CloudSync.Accounts.Sqlite.csproj" />
    <ProjectReference Include="../AStarDev.CloudSync.Sync.OneDrive/AStarDev.CloudSync.Sync.OneDrive.csproj" />
    <ProjectReference Include="../AStarDev.CloudSync.Sync.Sqlite/AStarDev.CloudSync.Sync.Sqlite.csproj" />
    <ProjectReference Include="../AStarDev.CloudSync.ViewModels/AStarDev.CloudSync.ViewModels.csproj" />
    <ProjectReference Include="../../../../packages/core/logging/AStarDev.LoggingExtensions/AStarDev.LoggingExtensions.csproj" />
    <ProjectReference Include="../../../../packages/core/logging/AStarDev.LoggingOTel/AStarDev.LoggingOTel.csproj" />
    <ProjectReference Include="../../../../packages/core/utilities/AStarDev.Localization/AStarDev.Localization.csproj" />
    <ProjectReference Include="../../../../packages/core/utilities/AStarDev.Utilities/AStarDev.Utilities.csproj" />
    <ProjectReference Include="../../../../packages/core/utilities/AStarDev.VelopackPublishing/AStarDev.VelopackPublishing.csproj" />
    <ProjectReference Include="../../../../packages/core/utilities/AStarDev.VelopackPublishingAvalonia/AStarDev.VelopackPublishingAvalonia.csproj" />
  </ItemGroup>

</Project>
