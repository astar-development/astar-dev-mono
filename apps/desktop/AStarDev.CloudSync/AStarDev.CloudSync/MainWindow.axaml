<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:accounts="using:AStarDev.CloudSync.Accounts"
        xmlns:folderSelection="using:AStarDev.CloudSync.FolderSelection"
        xmlns:layouts="using:AStarDev.CloudSync.Layouts"
        xmlns:syncRuns="using:AStarDev.CloudSync.SyncRuns"
        xmlns:vmSyncRuns="using:AStarDev.CloudSync.ViewModels.SyncRuns"
        xmlns:vm="using:AStarDev.CloudSync.ViewModels"
        xmlns:vmLayouts="using:AStarDev.CloudSync.ViewModels.Layouts"
        x:Class="AStarDev.CloudSync.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://AStarDev.CloudSync/Assets/astar.ico"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Border Grid.Row="0"
                Background="{DynamicResource CloudSyncWarnSoftBrush}"
                BorderBrush="{DynamicResource CloudSyncWarnBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                IsVisible="{Binding LayoutA.Overview.LoadErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding LayoutA.Overview.LoadErrorText}"
                       Foreground="{DynamicResource CloudSyncTextPrimaryBrush}"
                       TextWrapping="Wrap" />
        </Border>
        <ContentControl x:Name="LayoutHost"
                        Grid.Row="1"
                        IsEnabled="{Binding !IsDialogOpen}"
                        Content="{Binding CurrentLayout}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vmLayouts:LayoutAViewModel">
                    <layouts:LayoutAView />
                </DataTemplate>
                <DataTemplate DataType="vmLayouts:LayoutBViewModel">
                    <layouts:LayoutBView />
                </DataTemplate>
                <DataTemplate DataType="vmLayouts:LayoutCViewModel">
                    <layouts:LayoutCView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource CloudSyncScrimBrush}"
                IsVisible="{Binding AddAccount.IsOpen}">
            <accounts:AddAccountView DataContext="{Binding AddAccount}" />
        </Border>
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource CloudSyncScrimBrush}"
                IsVisible="{Binding AccountDialog.IsOpen}">
            <accounts:AccountDialogView DataContext="{Binding AccountDialog}" />
        </Border>
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource CloudSyncScrimBrush}"
                IsVisible="{Binding FolderSelection.IsOpen}">
            <folderSelection:FolderSelectionView DataContext="{Binding FolderSelection}" />
        </Border>
        <Border x:Name="SyncRestartPromptHost"
                x:DataType="vmSyncRuns:SyncRestartPromptViewModel"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource CloudSyncScrimBrush}"
                IsVisible="{Binding IsAsking, FallbackValue=False}">
            <syncRuns:SyncRestartPromptView />
        </Border>
    </Grid>
</Window>
