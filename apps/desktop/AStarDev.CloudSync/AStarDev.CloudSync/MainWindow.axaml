<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AStarDev.CloudSync.ViewModels"
        xmlns:layouts="using:AStarDev.CloudSync.Layouts"
        x:Class="AStarDev.CloudSync.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://AStarDev.CloudSync/Assets/astar.ico"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Title="{Binding Title}">
    <layouts:LayoutAView DataContext="{Binding LayoutA}" />
</Window>
