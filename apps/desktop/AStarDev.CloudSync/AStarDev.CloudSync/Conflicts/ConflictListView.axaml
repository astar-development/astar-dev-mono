<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conflicts="using:AStarDev.CloudSync.Conflicts"
             xmlns:vmConflicts="using:AStarDev.CloudSync.ViewModels.Conflicts"
             x:Class="AStarDev.CloudSync.Conflicts.ConflictListView"
             x:DataType="vmConflicts:ConflictListViewModel"
             VerticalContentAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             Foreground="{DynamicResource CloudSyncTextPrimaryBrush}">
    <Border Background="{DynamicResource CloudSyncSurfaceBrush}"
            BorderBrush="{DynamicResource CloudSyncBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="8"
                  Margin="24,20,24,12">
                <TextBlock Grid.Column="0"
                           Text="{Binding TitleText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="muted" Text="{Binding FilterLabelText}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Filters}"
                              SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding FilterLabelText}"
                              MinWidth="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vmConflicts:ConflictKindFilterViewModel">
                                <TextBlock Text="{Binding Text}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="secondary"
                        Content="{Binding RefreshText}"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="{Binding RefreshText}" />
                <Button Grid.Column="3"
                        Classes="secondary"
                        Content="{Binding CloseText}"
                        Command="{Binding CloseCommand}"
                        AutomationProperties.Name="{Binding CloseText}" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Name="ConflictScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MinHeight="0"
                          Padding="24,0,24,20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding LoadErrorText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource CloudSyncWarnBrush}"
                               IsVisible="{Binding LoadErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding EmptyText}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding IsEmpty}" />
                    <StackPanel Spacing="8" IsVisible="{Binding HasHeld}">
                        <TextBlock Text="{Binding HeldTitleText}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding HeldDeletions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vmConflicts:HeldDeletionItemViewModel">
                                    <Border Classes="conflict-card">
                                        <StackPanel Spacing="8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding HeaderText}" FontWeight="Medium" TextWrapping="Wrap" />
                                                <TextBlock Classes="muted" Text="{Binding SummaryText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                <Button Content="{Binding ConfirmText}"
                                                        Command="{Binding ConfirmCommand}"
                                                        AutomationProperties.Name="{Binding ConfirmAutomationName}" />
                                                <Button Content="{Binding RestoreText}"
                                                        Command="{Binding RestoreCommand}"
                                                        AutomationProperties.Name="{Binding RestoreAutomationName}" />
                                                <Button Content="{Binding LaterText}"
                                                        Command="{Binding LaterCommand}"
                                                        AutomationProperties.Name="{Binding LaterAutomationName}" />
                                                <Button Classes="secondary"
                                                        Content="{Binding ToggleText}"
                                                        Command="{Binding ToggleCommand}"
                                                        AutomationProperties.Name="{Binding ToggleAutomationName}" />
                                            </WrapPanel>
                                            <ItemsControl ItemsSource="{Binding PathTexts}" IsVisible="{Binding IsExpanded}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Classes="muted" Text="{Binding}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Classes="muted"
                                                       Text="{Binding DeferredText}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding IsDeferred}" />
                                            <TextBlock Text="{Binding ErrorText}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource CloudSyncWarnBrush}"
                                                       IsVisible="{Binding HasError}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding HasConflicts}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary"
                                    Content="{Binding SelectAllText}"
                                    Command="{Binding SelectAllCommand}"
                                    AutomationProperties.Name="{Binding SelectAllText}" />
                            <Button Classes="secondary"
                                    Content="{Binding ClearSelectionText}"
                                    Command="{Binding ClearSelectionCommand}"
                                    AutomationProperties.Name="{Binding ClearSelectionText}" />
                            <TextBlock Classes="muted" Text="{Binding SelectedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="muted" Text="{Binding BulkLabelText}" VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding BulkOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmConflicts:ConflictBulkOptionViewModel">
                                        <Button Content="{Binding Text}"
                                                Command="{Binding Command}"
                                                AutomationProperties.Name="{Binding AutomationName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Button Content="{Binding DefaultText}"
                                Command="{Binding DefaultCommand}"
                                AutomationProperties.Name="{Binding DefaultAutomationName}"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding HasDefault}" />
                        <TextBlock Text="{Binding BulkErrorText}"
                                   TextWrapping="Wrap"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource CloudSyncWarnBrush}"
                                   IsVisible="{Binding BulkErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmConflicts:ConflictAccountGroupViewModel">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vmConflicts:ConflictItemViewModel">
                                                <conflicts:ConflictCard />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
