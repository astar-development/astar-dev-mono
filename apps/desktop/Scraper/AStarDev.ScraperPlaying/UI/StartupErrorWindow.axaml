<Window Icon="/Assets/astar.png"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AStarDev.ScraperPlaying.UI.StartupErrorWindow"
        Title="AStarDev Scraper Playing - startup failed"
        Width="720"
        Height="320"
        MinWidth="480"
        MinHeight="200">
  <StackPanel Margin="32" Spacing="16">
    <TextBlock Text="AStarDev Scraper Playing could not start" FontSize="22" FontWeight="SemiBold" />
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" />
    <Button Content="Exit" HorizontalAlignment="Left" Click="Exit" />
  </StackPanel>
</Window>
