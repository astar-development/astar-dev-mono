<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AStarDev.WallpaperScraper.UI.UserSettingsEditor">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="12" ColumnSpacing="16" RowSpacing="8">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Email address" VerticalAlignment="Center" />
      <ContentControl Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
        <TextBox x:Name="EmailAddressBox" MinWidth="360" />
      </ContentControl>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Username" VerticalAlignment="Center" />
      <ContentControl Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left">
        <TextBox x:Name="UsernameBox" MinWidth="360" />
      </ContentControl>
      <TextBlock Grid.Row="2" Grid.Column="0" Text="API key" VerticalAlignment="Center" />
      <ContentControl Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBox x:Name="ApiKeyBox" MinWidth="360" PasswordChar="●" RevealPassword="{Binding #ShowApiKeyCheckBox.IsChecked}" />
          <CheckBox x:Name="ShowApiKeyCheckBox" Content="Show" />
        </StackPanel>
      </ContentControl>
    </Grid>
  </ScrollViewer>
</UserControl>
