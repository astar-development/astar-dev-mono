<Window Icon="/Assets/astar.png"
        xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:AStarDev.WallpaperScraper.UI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AStarDev.WallpaperScraper.UI.TagsEditorWindow"
        Title="Edit Tags"
        Width="900"
        Height="640"
        MinWidth="480"
        MinHeight="320">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24">
    <TextBox x:Name="FilterTextBox"
             Watermark="Filter by name or category"
             Margin="0,0,0,12"
             TextChanged="FilterChanged" />
    <Grid Grid.Row="1" ColumnDefinitions="*,160,80,Auto,Auto,Auto" ColumnSpacing="8" Margin="12,0,12,6">
      <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="Category" FontWeight="SemiBold" />
      <TextBlock Grid.Column="2" Text="Purity" FontWeight="SemiBold" />
      <TextBlock Grid.Column="3" Text="Ignore images" FontWeight="SemiBold" />
      <TextBlock Grid.Column="4" Text="Is name" FontWeight="SemiBold" />
      <TextBlock Grid.Column="5" Text="Is famous" FontWeight="SemiBold" />
    </Grid>
    <ListBox x:Name="TagsList" Grid.Row="2" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="ui:TagRow">
          <Grid ColumnDefinitions="*,160,80,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Category}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Purity}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="3" IsChecked="{Binding IgnoreImage}" />
            <CheckBox Grid.Column="4" IsChecked="{Binding IsName}" />
            <CheckBox Grid.Column="5" IsChecked="{Binding IsFamous}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />
    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="12"
                Margin="0,16,0,0">
      <Button x:Name="SaveButton" Content="Save" Click="Save" />
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel" />
    </StackPanel>
  </Grid>
</Window>
