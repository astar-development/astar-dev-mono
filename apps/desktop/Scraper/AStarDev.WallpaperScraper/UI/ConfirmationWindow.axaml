<Window Icon="/Assets/astar.png"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AStarDev.WallpaperScraper.UI.ConfirmationWindow"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
      <Button x:Name="ConfirmButton" Click="Confirm" />
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
