<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:classifications="clr-namespace:AStar.Dev.OneDrive.Sync.Client.Classifications"
        x:Class="AStar.Dev.OneDrive.Sync.Client.Classifications.CategoryEditDialog"
        x:DataType="classifications:CategoryNodeViewModel"
        Title="Edit category"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="Name"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
        <TextBox Text="{Binding EditedName}"
                 FontSize="{StaticResource FontSizeMd}"/>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox Content="Famous" IsChecked="{Binding IsFamous}"/>
            <CheckBox Content="Internet" IsChecked="{Binding IsInternet}"/>
        </StackPanel>

        <ToggleSwitch Content="Include in search"
                      IsChecked="{Binding IncludeInSearch}"/>

        <TextBlock Text="Parent"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
        <TextBox Text="{Binding ParentFilterText}"
                 PlaceholderText="Filter by name"
                 FontSize="{StaticResource FontSizeSm}"
                 CornerRadius="{StaticResource RadiusMd}"/>
        <ComboBox ItemsSource="{Binding FilteredParentOptionNames}"
                  SelectedItem="{Binding SelectedParentOptionName}"
                  HorizontalAlignment="Stretch"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel"
                    Padding="12,6"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Save"
                    Padding="12,6"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{DynamicResource TextAccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>

</Window>
