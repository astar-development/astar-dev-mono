<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AStar.Dev.Clock</AssemblyName>
    <RootNamespace>AStar.Dev.Clock</RootNamespace>
    <Product>AStar Development Clock</Product>
    <ApplicationIcon>Assets/astar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Testably.Abstractions" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <!-- Rely on Avalonia SDK defaults to include **/*.axaml once -->


  <!-- Ensure nested duplicate sources under src/ are not included in this project -->
  <ItemGroup>
    <Compile Remove="src/**/*.cs" />
    <AvaloniaResource Remove="src/**/*.axaml" />
    <None Remove="src/**" />
    <EmbeddedResource Remove="src/**" />
    <ProjectReference Include="../../../../packages/core/utilities/AStar.Dev.Velopack.Publishing.Avalonia/AStar.Dev.Velopack.Publishing.Avalonia.csproj" />
    <ProjectReference Include="../../../../packages/core/utilities/AStar.Dev.Velopack.Publishing/AStar.Dev.Velopack.Publishing.csproj" />
    <ProjectReference Include="../../../../packages/core/logging/AStarDev.LoggingSerilog/AStarDev.LoggingSerilog.csproj" />
    <None Update="Assets/astar.ico">
      <Pack>true</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
