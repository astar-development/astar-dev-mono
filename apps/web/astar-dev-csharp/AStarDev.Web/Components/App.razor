<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    <!-- No-flash theme script: must be inline, before stylesheets, synchronous -->
    <script>
        (function () {
            var valid = ['dark', 'light', 'metal', 'polished'];
            var stored;
            try { stored = localStorage.getItem('theme'); } catch (_) { }
            var theme = valid.indexOf(stored) !== -1 ? stored : 'dark';
            document.documentElement.className = 'theme-' + theme;
        })();
    </script>

    <link rel="stylesheet" href="@Assets["css/themes.css"]" />
    <link rel="stylesheet" href="@Assets["css/global.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AStarDev.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/theme.js"]"></script>
    <script src="@Assets["js/mobile-menu.js"]"></script>
    <script src="@Assets["js/cookie-consent.js"]"></script>
    <script src="@Assets["js/clipboard.js"]"></script>
</body>

</html>
