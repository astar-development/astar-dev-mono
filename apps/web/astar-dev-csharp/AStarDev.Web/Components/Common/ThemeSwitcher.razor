@rendermode InteractiveServer
@inject Theming.ThemeState ThemeState
@inject IJSRuntime JsRuntime

<div class="switcher" role="group" aria-label="Choose colour theme">
    @foreach (var option in Options)
    {
        <button
            type="button"
            class="theme-btn @(ThemeState.Current == option.Id ? "theme-btn--active" : string.Empty)"
            aria-label="@option.AriaLabel"
            aria-pressed="@(ThemeState.Current == option.Id ? "true" : "false")"
            @onclick="() => SelectAsync(option.Id)">
            <span aria-hidden="true">@option.Icon</span>
        </button>
    }
</div>
